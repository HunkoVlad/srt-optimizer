# Virtual environment
.venv/

# Local configuration and secrets
.env
.env.*
!config/*.example.env
config/email.toml
.local/

# Legacy top-level generated outputs
manifest.json
standardized/**
!standardized/
!standardized/.gitkeep
analysis/**
!analysis/
!analysis/.gitkeep

# Real run artifacts
data/runs/**
!data/
!data/runs/

# Logs
logs/**
!logs/
!logs/.gitkeep

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Test cache
.pytest_cache/

# Gmail OAuth credentials
config/gmail_oauth_client.json
config/*oauth*.json
config/*token*.json

# Private StayFi guest data and email logs
data/source/stayfi/*.csv
data/history/stayfi_anniversary_email_log.csv
